@saleId = <SaleID from list>
@taskId = <TaskID from sale detail>

### Sale list (header-only)
GET {{baseUrl}}/saleList?Page=1&Limit=5
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Sale list updated since
GET {{baseUrl}}/saleList?Page=1&Limit=5&UpdatedSince=2026-01-01T00:00:00.000
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Sale list ready for shipping
GET {{baseUrl}}/saleList?Page=1&Limit=5&ReadyForShipping=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Sale list by status
GET {{baseUrl}}/saleList?Page=1&Limit=5&Status=BACKORDERED
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Sale credit notes list
GET {{baseUrl}}/saleCreditNoteList?Page=1&Limit=5
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Sale detail (full nested tree incl. transactions)
GET {{baseUrl}}/sale?ID={{saleId}}&IncludeTransactions=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Sale detail without inventory movements
GET {{baseUrl}}/sale?ID={{saleId}}&HideInventoryMovements=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Quote
GET {{baseUrl}}/sale/quote?SaleID={{saleId}}&IncludeProductInfo=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Order
GET {{baseUrl}}/sale/order?SaleID={{saleId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Fulfilment
GET {{baseUrl}}/sale/fulfilment?SaleID={{saleId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Pick (TaskID from fulfilment)
GET {{baseUrl}}/sale/fulfilment/pick?TaskID={{taskId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Pack
GET {{baseUrl}}/sale/fulfilment/pack?TaskID={{taskId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Ship
GET {{baseUrl}}/sale/fulfilment/ship?TaskID={{taskId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Invoice
GET {{baseUrl}}/sale/invoice?SaleID={{saleId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Credit note
GET {{baseUrl}}/sale/creditnote?SaleID={{saleId}}&IncludePaymentInfo=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Payments
GET {{baseUrl}}/sale/payment?SaleID={{saleId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Manual journals
GET {{baseUrl}}/sale/manualJournal?SaleID={{saleId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Attachments
GET {{baseUrl}}/sale/attachment?SaleID={{saleId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

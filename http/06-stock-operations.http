@adjustmentId = <id from list>
@transferId = <id from list>
@stockTakeId = <id from list>

### Stock adjustments
GET {{CIN7_BASE_URL}}/v2/stockadjustmentList?Page=1&Limit=5
api-auth-accountid: {{CIN7_ACCOUNT_ID}}
api-auth-applicationkey: {{CIN7_APPLICATION_KEY}}
Content-Type: application/json

### Stock adjustment detail
GET {{CIN7_BASE_URL}}/v2/stockadjustment?ID={{adjustmentId}}
api-auth-accountid: {{CIN7_ACCOUNT_ID}}
api-auth-applicationkey: {{CIN7_APPLICATION_KEY}}
Content-Type: application/json

### Stock transfers
GET {{CIN7_BASE_URL}}/v2/stockTransferList?Page=1&Limit=5
api-auth-accountid: {{CIN7_ACCOUNT_ID}}
api-auth-applicationkey: {{CIN7_APPLICATION_KEY}}
Content-Type: application/json

### Stock transfer detail
GET {{CIN7_BASE_URL}}/v2/stockTransfer?ID={{transferId}}
api-auth-accountid: {{CIN7_ACCOUNT_ID}}
api-auth-applicationkey: {{CIN7_APPLICATION_KEY}}
Content-Type: application/json

### Stock takes

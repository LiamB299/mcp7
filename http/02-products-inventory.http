@productId = <product GUID from list>
@sku = <SKU>

### Products (first 5, active only)
GET {{baseUrl}}/product?Page=1&Limit=5
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Products incl. deprecated
GET {{baseUrl}}/product?Page=1&Limit=5&IncludeDeprecated=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Product detail with expansions (BOM, suppliers, movements, reorder levels, custom prices)
GET {{baseUrl}}/product?ID={{productId}}&IncludeBOM=true&IncludeSuppliers=true&IncludeMovements=true&IncludeReorderLevels=true&IncludeCustomPrices=true
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Product by SKU
GET {{baseUrl}}/product?Sku={{sku}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Products modified since
GET {{baseUrl}}/product?Page=1&Limit=5&ModifiedSince=2026-01-01T00:00:00.000
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Availability (one row per product x location x bin x batch)
GET {{baseUrl}}/ref/productavailability?Page=1&Limit=10
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Availability for one SKU
GET {{baseUrl}}/ref/productavailability?Sku={{sku}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Product families
GET {{baseUrl}}/productFamily?Page=1&Limit=5
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Suppliers of a product
GET {{baseUrl}}/product-suppliers?ProductID={{productId}}
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Deals
GET {{baseUrl}}/reference/deals?Page=1&Limit=5
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Discount rules
GET {{baseUrl}}/reference/discount?Page=1&Limit=5
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json

### Ledger transactions
GET {{baseUrl}}/transactions?FromDate=2026-01-01T00:00:00.000&ToDate=2026-12-31T00:00:00.000&Page=1&Limit=10
api-auth-accountid: {{accountId}}
api-auth-applicationkey: {{applicationKey}}
Content-Type: application/json
